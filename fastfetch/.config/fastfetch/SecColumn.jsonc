{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "modules": [
    "break",
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌──────────────────────── Internals ───────────────────────┐"
    },
    {
      "type": "os",
      "key": " OS ",
      "keyColor": "yellow"
    },
    {
      "type": "kernel",
      "key": " │ ›󰌽 ",
      "keyColor": "yellow"
    },
    {
      "type": "bios",
      "key": " │ ›󰖡 ",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": " │ ›󰏗 ",
      "keyColor": "yellow"
    },
    {
      "type": "command",
      "key": " └ ›󰞷 ",
      "keyColor": "yellow",
      "text": "$SHELL --version | sed 's/, version//'"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[1;34m  SOFTWARE\u001b[0m"
    },
    {
      "type": "de",
      "key": " 󰧨  DE",
      "keyColor": "blue"
    },
    {
      "type": "lm",
      "key": " │ ›󰍁 ",
      "keyColor": "blue"
    },
    {
      "type": "wm",
      "key": " │ ›󱂬 ",
      "keyColor": "blue"
    },
    {
      "type": "wmtheme",
      "key": " │ ›󰉦 ",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": " └ ›󰆍 ",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└──────────────────────────────────────────────────────────┘"
    },
    "break",
    "break",
    "break",
    {
      "type": "custom",
      "format": "\u001b[90m┌────────────────────────── Extras ─────────────────────────┐"
    },
    {
      "type": "custom",
      "format": "\u001b[1;35m 󱖏 MIDIA\u001b[0m"
    },
    {
      "type": "media",
      "key": "  MUSIC ",
      "keyColor": "magenta"
    },
    {
      "type": "sound",
      "key": " │ ›󰖁 ",
      "keyColor": "magenta"
    },
    {
      "type": "custom",
      "format": "\u001b[90m└──────────────────────────────────────────────────────────┘"
    }
  ]
}
