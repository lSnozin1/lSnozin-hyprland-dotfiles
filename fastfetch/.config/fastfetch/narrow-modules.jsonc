{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "modules": [
    "title",
    "break",
    {
      "type": "custom",
      "format": "\u001b[97m┌────────────────────────── Hardware ──────────────────────────┐"
    },
    {
      "type": "host",
      "key": " 󰌢  PC",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "format": "\u001b[1;32m 󰨇 Core Hardware\u001b[0m"
    },
    {
      "type": "cpu",
      "key": " │ ›󰻠 CPU ",
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": " │ ›󰢮 GPU",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": " │ ›󰑭 MEM",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "format": "\u001b[1;32m 󰋊 DISKS\u001b[0m"
    },
    {
      "type": "disk",
      "folders": "/",
      "key": " │ ›󰋊 SSD Sistema",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "folders": "/mnt/dados",
      "key": " │ ›󰋊 SSD Dados",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "folders": "/mnt/SO",
      "key": " │ ›󰋊 SSD Windows",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "format": "\u001b[1;32m 󱄄 MONITORS\u001b[0m"
    },
    {
      "type": "display",
      "key": " └ ›󰍹 DISPLAY",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "format": "\u001b[97m└──────────────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[97m┌──────────────────────── Date / Time ─────────────────────────┐"
    },
    {
      "type": "custom",
      "format": "\u001b[1;35m  DATE/TIME\u001b[0m"
    },
    {
      "type": "command",
      "key": " │ ›  OS Age  ",
      "keyColor": "magenta",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "uptime",
      "key": " │ ›  Uptime  ",
      "keyColor": "magenta"
    },
    {
      "type": "datetime",
      "key": " └ ›  DateTime  ",
      "keyColor": "magenta"
    },
    {
      "type": "custom",
      "format": "\u001b[97m└──────────────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[97m┌────────────────────────── Internals ─────────────────────────┐"
    },
    {
      "type": "os",
      "key": " OS ",
      "keyColor": "yellow"
    },
    {
      "type": "kernel",
      "key": " │ ›󰌽 ",
      "keyColor": "yellow"
    },
    {
      "type": "bios",
      "key": " │ ›󰖡 ",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": " │ ›󰏗 ",
      "keyColor": "yellow"
    },
    {
      "type": "command",
      "key": " └ ›󰞷 ",
      "keyColor": "yellow",
      "text": "$SHELL --version | sed 's/, version//'"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[1;34m  SOFTWARE\u001b[0m"
    },
    {
      "type": "de",
      "key": " 󰧨  DE",
      "keyColor": "blue"
    },
    {
      "type": "lm",
      "key": " │ ›󰍁 ",
      "keyColor": "blue"
    },
    {
      "type": "wm",
      "key": " │ ›󱂬 ",
      "keyColor": "blue"
    },
    {
      "type": "wmtheme",
      "key": " │ ›󰉦 ",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": " └ ›󰆍 ",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "format": "\u001b[97m└──────────────────────────────────────────────────────────────┘"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
