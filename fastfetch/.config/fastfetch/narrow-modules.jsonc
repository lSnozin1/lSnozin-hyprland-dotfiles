{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "~/.config/fastfetch/fetch.png",
    "width": 30,
    "height": 15,
    "padding": {
      "top": 1,
      "left": 3
    },
    "color": {
      "1": "cyan"
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    {
      "type": "custom",
      "format": "\u001b[38;5;211m╭───────────╮\u001b[0m"
    },
    {
      "type": "title",
      "key": "\u001b[38;5;211m│\u001b[0m \u001b[211m  user   \u001b[38;5;211m│\u001b[0m",
      "keyColor": "magenta",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;211m├───────────┤\u001b[0m"
    },
    {
      "type": "os",
      "key": "\u001b[38;5;211m│\u001b[0m \u001b[37m󰻀  distro \u001b[38;5;211m│\u001b[0m",
      "keyColor": "red",
      "format": "{name} {arch}"
    },
    {
      "type": "kernel",
      "key": "\u001b[38;5;211m│\u001b[0m \u001b[37m󰌢  kernel \u001b[38;5;211m│\u001b[0m",
      "keyColor": "magenta",
      "format": "{release}"
    },
    {
      "type": "wm",
      "key": "\u001b[38;5;211m│\u001b[0m \u001b[36m  WM     \u001b[38;5;211m│\u001b[0m",
      "keyColor": "cyan",
      "format": "{pretty-name}"
    },
    {
      "type": "packages",
      "key": "\u001b[38;5;211m│\u001b[0m \u001b[36m󰏖  pkgs   \u001b[38;5;211m│\u001b[0m",
      "keyColor": "cyan",
      "format": "{pacman} (pacman)"
    },
    {
      "type": "command",
      "key": "\u001b[38;5;211m│\u001b[0m \u001b[33m  shell  \u001b[38;5;211m│\u001b[0m",
      "keyColor": "yellow",
      "text": "basename \"$SHELL\""
    },
    {
        "type": "command",
        "key": "\u001b[38;5;211m│\u001b[0m \u001b[33m󰍛  RAM    \u001b[38;5;211m│\u001b[0m",
        "keyColor": "yellow",
        "text": "ram=$(free -h | awk '/Mem:/ {print $3 \"/\" $2}'); swap=$(free -h | awk '/Swap:/ {print $3 \"/\" $2}'); ram_pct=$(free | awk '/Mem:/ {printf \"%.0f\", $3/$2*100}'); swap_pct=$(free | awk '/Swap:/ && $2>0 {printf \"%.0f\", $3/$2*100}'); echo -e \"$ram | $swap (\\033[33m$ram_pct%\\033[0m|\\033[33m$swap_pct%\\033[0m)\""
    },
    {
      "type": "uptime",
      "key": "\u001b[38;5;211m│\u001b[0m \u001b[32m󰦖  uptime \u001b[38;5;211m│\u001b[0m",
      "keyColor": "green",
      "format": "{days} day(s), {hours} hour(s), {minutes} minute(s)"
    },
    {
      "type": "command",
      "key": "\u001b[38;5;211m│\u001b[0m \u001b[32m󰦖  OS age \u001b[38;5;211m│\u001b[0m",
      "keyColor": "green",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo \"$days_difference day(s)\""
    },
    {
      "type": "custom",
      "format": "\u001b[38;5;211m╰───────────╯\u001b[0m"
    }
  ]
}