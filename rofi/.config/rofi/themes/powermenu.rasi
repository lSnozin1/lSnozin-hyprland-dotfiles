@import "config.rasi"

configuration {
    show-icons: false;
}

window {
    width: 260px;
    location: center;
    anchor: center;
}

mainbox {
    children: [ "listview" ];
}

listview {
    lines: 5;
    spacing: 4px;
}

element {
    padding: 6px 12px;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}
