#!/usr/bin/env bash
# desktop-widgets: manage, reload, and log the Quickshell desktop-widgets session.

WIDGET_DIR="$HOME/.config/quickshell/desktop-widgets"
if [ ! -d "$WIDGET_DIR" ]; then
    WIDGET_DIR="$HOME/Projects/lSnozin-hyprland-dotfiles/.config/quickshell/desktop-widgets"
fi

LOG_DIR="$HOME/Documents/_docs_/Logs/DesktopWidgets"
PID_FILE="${XDG_RUNTIME_DIR:-/tmp}/desktop-widgets.pid"
SOCKET="/tmp/fetch-panel"
KEEP_NORMAL=5
KEEP_DAYS_PROBLEM=30

stop_existing() {
    if [ -f "$PID_FILE" ]; then
        OLD_PID="$(cat "$PID_FILE" 2>/dev/null)"
        if [ -n "$OLD_PID" ] && kill -0 "$OLD_PID" 2>/dev/null; then
            kill -TERM "$OLD_PID" 2>/dev/null
            for _ in $(seq 1 40); do
                kill -0 "$OLD_PID" 2>/dev/null || break
                sleep 0.05
            done
        fi
        rm -f "$PID_FILE"
    fi

    pkill -TERM -f "qs -p .*desktop-widgets" 2>/dev/null || true
    pkill -TERM -f "kitten panel.*fetch-panel" 2>/dev/null || true
    rm -f "$SOCKET"
}

run_foreground() {
    mkdir -p "$LOG_DIR" 2>/dev/null
    echo "$$" > "$PID_FILE"

    STAMP="$(date +%Y-%m-%d_%H-%M-%S)"
    BASE="$STAMP"
    COUNTER=1
    while compgen -G "$LOG_DIR/${BASE}_*.log" > /dev/null; do
        COUNTER=$((COUNTER + 1))
        BASE="${STAMP}-${COUNTER}"
    done
    LOG_FILE="$LOG_DIR/${BASE}_running.log"
    ln -sfn "$LOG_FILE" "$LOG_DIR/latest.log"

    # Keep only the last N normal sessions; retain error/crash logs longer
    mapfile -t OLD_NORMAL < <(
        find "$LOG_DIR" -maxdepth 1 -type f \( -name "*_ok.log" -o -name "*_stopped.log" \) \
            | sort -r | tail -n +"$((KEEP_NORMAL + 1))"
    )
    if [ "${#OLD_NORMAL[@]}" -gt 0 ]; then
        rm -f "${OLD_NORMAL[@]}"
    fi
    find "$LOG_DIR" -maxdepth 1 -type f -name "2???-??-??_*.log" \
        ! -name "*_ok.log" ! -name "*_stopped.log" ! -name "*_running.log" \
        -mtime +"$KEEP_DAYS_PROBLEM" -delete 2>/dev/null

    {
        echo "wrapper: start=$(date -Is) pid=$$ widget_dir=$WIDGET_DIR"
        echo "wrapper: qs=$(qs --version 2>/dev/null | head -n 1 || echo unknown) wayland=${WAYLAND_DISPLAY:-unknown}"
    } > "$LOG_FILE"

    START=$(date +%s)
    CHILD=""
    STOP_REASON=""

    handle_signal() {
        STOP_REASON="$1"
        [ -n "$CHILD" ] && kill -TERM "$CHILD" 2>/dev/null
    }
    trap 'handle_signal TERM' TERM
    trap 'handle_signal INT' INT
    trap 'handle_signal HUP' HUP

    qs -p "$WIDGET_DIR" >> "$LOG_FILE" 2>&1 &
    CHILD=$!

    wait "$CHILD"
    CODE=$?
    while kill -0 "$CHILD" 2>/dev/null; do
        wait "$CHILD"
        CODE=$?
    done
    END=$(date +%s)

    pkill -TERM -f "kitten panel.*fetch-panel" 2>/dev/null || true
    rm -f "$SOCKET"

    SIGNAL="$STOP_REASON"
    if [ -z "$SIGNAL" ] && [ "$CODE" -gt 128 ]; then
        SIGNAL="$(kill -l $((CODE - 128)) 2>/dev/null)"
    fi

    if [[ " SEGV ABRT BUS ILL FPE " == *" $SIGNAL "* ]]; then
        RESULT="crash"
    elif [[ " TERM INT HUP " == *" $SIGNAL "* ]]; then
        RESULT="stopped"
    elif [ "$CODE" -ne 0 ]; then
        RESULT="error"
    else
        RESULT="ok"
    fi

    LOG_LINES="$(wc -l < "$LOG_FILE")"
    TOP_REPEATED="$(grep -a -v '^wrapper:' "$LOG_FILE" | sed -E 's/[0-9]+/N/g' | sort | uniq -c | sort -rn | head -n 5 | cut -c1-170)"

    {
        echo "wrapper: end=$(date -Is) exit_code=$CODE signal=${SIGNAL:-none} duration=$((END - START))s result=$RESULT log_lines=$LOG_LINES"
        echo "wrapper: most repeated lines (numbers collapsed to N)"
        if [ -n "$TOP_REPEATED" ]; then
            printf '%s\n' "$TOP_REPEATED" | sed 's/^/wrapper:   /'
        else
            echo "wrapper:   (none)"
        fi
    } >> "$LOG_FILE"

    FINAL_FILE="$LOG_DIR/${BASE}_${RESULT}.log"
    mv -f "$LOG_FILE" "$FINAL_FILE"
    if [ "$(readlink "$LOG_DIR/latest.log" 2>/dev/null)" = "$LOG_FILE" ]; then
        ln -sfn "$FINAL_FILE" "$LOG_DIR/latest.log"
    fi

    if [ "$(cat "$PID_FILE" 2>/dev/null)" = "$$" ]; then
        rm -f "$PID_FILE"
    fi
    exit "$CODE"
}

case "${1:-reload}" in
    run)
        run_foreground
        ;;
    reload|start)
        stop_existing
        setsid -f "$0" run >/dev/null 2>&1
        ;;
    stop)
        stop_existing
        ;;
    log)
        exec tail -n 100 -f "$LOG_DIR/latest.log"
        ;;
    *)
        echo "Usage: $(basename "$0") [reload|stop|log|run]" >&2
        exit 1
        ;;
esac