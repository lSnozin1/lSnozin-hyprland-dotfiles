[Desktop Entry]
Name=Discord
StartupWMClass=discord
Comment= Discord with auto, wayland priority, has middle click scroll enabled
GenericName=Internet Messenger
Exec=/usr/bin/discord --ozone-platform-hint=auto --enable-blink-features=MiddleClickAutoscroll --url -- %u
Icon=discord
Type=Application
Categories=Network;InstantMessaging;
MimeType=x-scheme-handler/discord;
Path=/usr/bin
