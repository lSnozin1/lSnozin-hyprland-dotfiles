    def _set_preview_background(self, key: str) -> None:
        if key not in ("dark", "gray", "light", "custom"):
            return
        self.preview_bg_key = key
        chip = self.bg_chips.get(key)
        if chip and not chip.isChecked():
            chip.setChecked(True)
        self._apply_preview_background_style()

    def _on_preview_bg_hex_changed(self, text: str) -> None:
        try:
            norm = normalize_hex(text)
        except FolderIconError:
            return
        self.custom_preview_bg_hex = norm
        self._set_preview_background("custom")

    def _pick_preview_bg_color(self) -> None:
        chosen = QColorDialog.getColor(
            QColor(self.custom_preview_bg_hex),
            self,
            "Choose Preview Background Color",
        )
        if chosen.isValid():
            norm = chosen.name().lower()
            self.custom_preview_bg_hex = norm
            self.preview_bg_input.blockSignals(True)
            self.preview_bg_input.setText(norm)
            self.preview_bg_input.blockSignals(False)
            self._set_preview_background("custom")

    def _active_preview_bg_hex(self) -> str:
        if self.preview_bg_key == "custom":
            return self.custom_preview_bg_hex
        return PREVIEW_PRESETS.get(self.preview_bg_key, "#0e0e14")

    def _apply_preview_background_style(self) -> None:
        bg_hex = self._active_preview_bg_hex()
        r, g, b = parse_hex(bg_hex)
        # Ensure high contrast for the readout label on any preview background
        auto_contrast = contrast_color(r, g, b, "auto")
        text_hex = "#e5e7eb" if auto_contrast == "#ffffff" else "#111827"

        self.preview_box.setStyleSheet(
            f"QFrame#PreviewBox {{ background-color: {bg_hex}; border: 1px solid #2a2438; border-radius: 12px; }}"
        )
        self.contrast_readout.setStyleSheet(
            f"background-color: transparent; color: {text_hex}; font-size: 12px; font-weight: 600;"
        )

    def _rebuild_swatches(self) -> None:
        while self.swatch_row.count():
            child = self.swatch_row.takeAt(0)
            if child.widget():
                child.widget().deleteLater()

        combined: list[str] = []
        for c in self.state.get("recent_colors", []) + PRESET_COLORS:
            norm = c.lower()
            if norm not in combined:
                combined.append(norm)
            if len(combined) >= 8:
                break

        for hex_col in combined:
            btn = QPushButton()
            btn.setFixedSize(26, 22)
            btn.setToolTip(hex_col)
            btn.setStyleSheet(
                f"background-color: {hex_col}; border: 1px solid #3f3f52; border-radius: 5px;"
            )
            btn.clicked.connect(lambda _checked=False, col=hex_col: self._set_folder_color(col))
            self.swatch_row.addWidget(btn)

        self.swatch_row.addStretch(1)

    def _record_recent_color(self, hex_col: str) -> None:
        norm = hex_col.lower()
        recent = [c.lower() for c in self.state.get("recent_colors", []) if c.lower() != norm]
        recent.insert(0, norm)
        self.state["recent_colors"] = recent[:8]
        save_gui_state(self.state)
        self._rebuild_swatches()

    def _update_swatch_button_style(self) -> None:
        self.color_swatch_btn.setStyleSheet(
            f"background-color: {self.folder_hex}; border: 1px solid #52526b; border-radius: 6px;"
        )

    def _set_folder_color(self, hex_col: str) -> None:
        try:
            norm = normalize_hex(hex_col)
        except FolderIconError:
            return
        self.folder_hex = norm
        if self.hex_input.text().lower() != norm:
            self.hex_input.blockSignals(True)
            self.hex_input.setText(norm)
            self.hex_input.blockSignals(False)
        self._update_swatch_button_style()
        self.update_preview()

    def _pick_folder_color(self) -> None:
        chosen = QColorDialog.getColor(QColor(self.folder_hex), self, "Choose Folder Color")
        if chosen.isValid():
            self._set_folder_color(chosen.name())

    def _on_hex_text_changed(self, text: str) -> None:
        try:
            norm = normalize_hex(text)
            self.folder_hex = norm
            self._update_swatch_button_style()
            self.update_preview()
        except FolderIconError:
            pass

    def _on_contrast_mode_changed(self, index: int) -> None:
        modes = ["auto", "white", "black", "custom"]
        self.contrast_mode = modes[index]
        is_custom = self.contrast_mode == "custom"
        self.sym_hex_input.setEnabled(is_custom)
        self.sym_pick_btn.setEnabled(is_custom)
        self.update_preview()

    def _on_sym_hex_changed(self, text: str) -> None:
        try:
            self.custom_symbol_hex = normalize_hex(text)
            self.update_preview()
        except FolderIconError:
            pass

    def _pick_symbol_color(self) -> None:
        chosen = QColorDialog.getColor(QColor(self.custom_symbol_hex), self, "Choose Symbol Color")
        if chosen.isValid():
            self.sym_hex_input.setText(chosen.name())

    def _on_scale_changed(self, value: int) -> None:
        self.scale_ratio = value / 100.0
        self.scale_val_lbl.setText(f"{value}%")
        self.update_preview()

    def _reset_symbol_style(self) -> None:
        modes = ["auto", "white", "black", "custom"]
        default_mode = SYMBOL_CONTRAST_MODE if SYMBOL_CONTRAST_MODE in modes else "auto"
        default_scale_pct = int(round(SYMBOL_SCALE * 100))

        self.contrast_mode = default_mode
        self.custom_symbol_hex = "#ffffff"
        self.scale_ratio = SYMBOL_SCALE

        self.contrast_combo.blockSignals(True)
        self.contrast_combo.setCurrentIndex(modes.index(default_mode))
        self.contrast_combo.blockSignals(False)

        self.sym_hex_input.blockSignals(True)
        self.sym_hex_input.setText(self.custom_symbol_hex)
        self.sym_hex_input.blockSignals(False)
        is_custom = default_mode == "custom"
        self.sym_hex_input.setEnabled(is_custom)
        self.sym_pick_btn.setEnabled(is_custom)

        self.scale_slider.blockSignals(True)
        self.scale_slider.setValue(default_scale_pct)
        self.scale_slider.blockSignals(False)
        self.scale_val_lbl.setText(f"{default_scale_pct}%")

        self.update_preview()
        self.status_label.setText(
            f"Symbol style reset to defaults ({default_mode}, {default_scale_pct}%)."
        )

    def _on_symbol_selected(self, current: QListWidgetItem | None, _prev: QListWidgetItem | None) -> None:
        if current is None:
            return
        self.lucide_preview_name = None
        self.lucide_preview_inner = None
        self.selected_symbol = current.data(Qt.ItemDataRole.UserRole)
        if self.selected_symbol:
            self.alias_target_combo.setCurrentText(self.selected_symbol)
        self._sync_custom_delete_state()
        self.update_preview()

    def _sync_custom_delete_state(self) -> None:
        is_custom = bool(self.selected_symbol and self.selected_symbol in self.custom_symbols)
        self.delete_custom_btn.setEnabled(is_custom)

    def _effective_symbol_color_arg(self) -> str | None:
        if self.contrast_mode == "custom":
            return self.custom_symbol_hex
        if self.contrast_mode == "white":
            return "#ffffff"
        if self.contrast_mode == "black":
            return "#000000"
        return None

    def _active_preview_symbols_and_name(self) -> tuple[dict[str, str], str | None, bool]:
        if self.lucide_preview_name and self.lucide_preview_inner:
            merged = dict(self.all_symbols)
            merged[self.lucide_preview_name] = self.lucide_preview_inner
            is_unimported = self.lucide_preview_name not in self.all_symbols
            return merged, self.lucide_preview_name, is_unimported
        return self.all_symbols, self.selected_symbol, False

    def update_preview(self) -> None:
        sym_override = self._effective_symbol_color_arg()
        symbols_map, active_sym, is_unimported_preview = self._active_preview_symbols_and_name()

        svg_text = build_folder_svg(
            hex_color=self.folder_hex,
            symbol=active_sym,
            symbol_color=sym_override,
            all_symbols=symbols_map,
            contrast_mode="auto",
            scale_ratio=self.scale_ratio,
        )
        self.preview_svg.load(QByteArray(svg_text.encode("utf-8")))

        if is_unimported_preview and active_sym:
            self.symbol_badge.setText(f"{active_sym} (preview)")
        else:
            canon = canonical_symbol_name(active_sym, self.aliases)
            self.symbol_badge.setText(f"symbol: {canon or 'none'}")

        if not active_sym:
            self.contrast_readout.setText("glyph: none")
        elif sym_override:
            self.contrast_readout.setText(f"glyph: {sym_override}")
        else:
            r, g, b = parse_hex(self.folder_hex)
            auto_col = contrast_color(r, g, b, "auto")
            self.contrast_readout.setText(f"glyph: auto ({auto_col})")

    # -----------------------------------------------------------------------
    # TARGET FOLDER MANAGEMENT (Single & Multi Modes)
    # -----------------------------------------------------------------------

    def _on_multi_mode_toggled(self, checked: bool) -> None:
        self.multi_mode = checked
        self.single_target_widget.setVisible(not checked)
        self.multi_target_widget.setVisible(checked)

        if checked:
            raw = self.folder_input.text().strip()
            if raw:
                candidate = Path(raw).expanduser()
                if candidate.is_dir():
                    self._add_multi_folders([candidate])
        else:
            if self.multi_folder_list.count() > 0:
                first_path = self.multi_folder_list.item(0).data(Qt.ItemDataRole.UserRole)
                if isinstance(first_path, Path):
                    self.folder_input.setText(str(first_path))

        self._refresh_target_status()

    def _add_multi_folders(self, paths: list[Path]) -> int:
        existing: set[Path] = set()
        for idx in range(self.multi_folder_list.count()):
            val = self.multi_folder_list.item(idx).data(Qt.ItemDataRole.UserRole)
            if isinstance(val, Path):
                existing.add(val)

        added = 0
        for p in paths:
            try:
                resolved = p.expanduser().resolve()
            except Exception:
                continue
            if not resolved.is_dir() or resolved in existing:
                continue
            existing.add(resolved)
            item = QListWidgetItem(str(resolved))
            item.setData(Qt.ItemDataRole.UserRole, resolved)
            item.setToolTip(f"{resolved}\n{summarize_folder_icon(resolved)}")
            self.multi_folder_list.addItem(item)
            added += 1

        self._sync_multi_buttons()
        self._refresh_target_status()
        return added

    def _on_add_multi_folder_clicked(self) -> None:
        fallback = Path(self.state.get("last_folder", str(Path.home())))
        start = str(fallback if fallback.is_dir() else Path.home())
        chosen = QFileDialog.getExistingDirectory(self, "Add Target Folder", start)
        if chosen:
            chosen_path = Path(chosen)
            self._add_multi_folders([chosen_path])
            self.state["last_folder"] = str(chosen_path.parent)
            save_gui_state(self.state)

    def _on_remove_multi_folders_clicked(self) -> None:
        for item in self.multi_folder_list.selectedItems():
            row = self.multi_folder_list.row(item)
            self.multi_folder_list.takeItem(row)
        self._sync_multi_buttons()
        self._refresh_target_status()

    def _on_clear_multi_folders_clicked(self) -> None:
        self.multi_folder_list.clear()
        self._sync_multi_buttons()
        self._refresh_target_status()

    def _sync_multi_buttons(self) -> None:
        has_items = self.multi_folder_list.count() > 0
        has_selection = len(self.multi_folder_list.selectedItems()) > 0
        self.remove_folder_btn.setEnabled(has_selection)
        self.clear_folders_btn.setEnabled(has_items)

    def _refresh_multi_item_tooltips(self) -> None:
        for idx in range(self.multi_folder_list.count()):
            item = self.multi_folder_list.item(idx)
            val = item.data(Qt.ItemDataRole.UserRole)
            if isinstance(val, Path):
                item.setToolTip(f"{val}\n{summarize_folder_icon(val)}")

    def _refresh_target_status(self) -> None:
        if self.multi_mode:
            count = self.multi_folder_list.count()
            self.apply_btn.setText(
                f"Apply to {count} Folder{'s' if count != 1 else ''}" if count > 0 else "Apply to Folders"
            )
            self.revert_btn.setText(
                f"Revert {count} Folder{'s' if count != 1 else ''}" if count > 0 else "Revert Folders"
            )
            self.revert_btn.setEnabled(count > 0)
            self._refresh_multi_item_tooltips()
            return

        self.apply_btn.setText("Apply to Folder")
        self.revert_btn.setText("Revert Folder")

        raw = self.folder_input.text().strip()
        if not raw:
            self.folder_status_label.setText("No folder selected")
            self.folder_status_label.setStyleSheet("background-color: transparent; color: #9ca3af; font-size: 12px;")
            self.revert_btn.setEnabled(False)
            return

        candidate = Path(raw).expanduser()
        if not candidate.is_dir():
            self.folder_status_label.setText("Not a valid directory")
            self.folder_status_label.setStyleSheet("background-color: transparent; color: #fb7185; font-size: 12px;")
            self.revert_btn.setEnabled(False)
            return

        info = inspect_directory_icon(candidate)
        summary = summarize_folder_icon(candidate)
        has_icon = bool(info["exists"] and info["icon"])
        self.revert_btn.setEnabled(has_icon)

        if has_icon:
            self.folder_status_label.setText(summary)
            self.folder_status_label.setStyleSheet("background-color: transparent; color: #d8b4fe; font-size: 12px;")
        else:
            self.folder_status_label.setText(summary)
            self.folder_status_label.setStyleSheet("background-color: transparent; color: #9ca3af; font-size: 12px;")

    def _collect_target_folders(self) -> list[Path] | None:
        if self.multi_mode:
            folders: list[Path] = []
            for idx in range(self.multi_folder_list.count()):
                val = self.multi_folder_list.item(idx).data(Qt.ItemDataRole.UserRole)
                if isinstance(val, Path) and val.is_dir():
                    folders.append(val)
            if not folders:
                QMessageBox.warning(self, "No Target Folders", "Add at least one valid folder to the queue.")
                return None
            return folders

        raw_folder = self.folder_input.text().strip()
        if not raw_folder:
            QMessageBox.warning(self, "Missing Folder", "Please select or enter a target folder path.")
            return None

        folder_path = Path(raw_folder).expanduser().resolve()
        if not folder_path.is_dir():
            QMessageBox.critical(self, "Invalid Directory", f"Not a valid directory:\n{folder_path}")
            return None
        return [folder_path]

    # -----------------------------------------------------------------------
    # FOLDER & SVG ACTIONS
    # -----------------------------------------------------------------------

    def _browse_folder(self) -> None:
        raw = self.folder_input.text().strip()
        fallback = Path(self.state.get("last_folder", str(Path.home())))
        current = Path(raw).expanduser() if raw else fallback
        start = str(current if current.is_dir() else Path.home())
        chosen = QFileDialog.getExistingDirectory(self, "Select Target Folder", start)
        if chosen:
            self.folder_input.setText(chosen)

    def _on_save_svg_clicked(self) -> None:
        if not self._ensure_preview_imported_if_needed():
            return

        save_dir = self._get_svg_save_dir()
        if save_dir.exists() and not save_dir.is_dir():
            QMessageBox.critical(
                self,
                "Invalid SVG Save Path",
                f"Configured SVG save path is a file, not a directory:\n{save_dir}\n\n"
                "Update it in the Options tab.",
            )
            return

        sym_override = self._effective_symbol_color_arg()
        dest = icon_path(
            symbol=self.selected_symbol,
            hex_color=self.folder_hex,
            out_dir=save_dir,
            symbol_color=sym_override,
            scale_ratio=self.scale_ratio,
            aliases=self.aliases,
        )

        svg_text = build_folder_svg(
            hex_color=self.folder_hex,
            symbol=self.selected_symbol,
            symbol_color=sym_override,
            all_symbols=self.all_symbols,
            scale_ratio=self.scale_ratio,
        )
        try:
            write_icon(svg_text, dest)
        except Exception as exc:
            QMessageBox.critical(self, "Save Failed", f"Could not write SVG to {dest}:\n{exc}")
            return

        self._record_recent_color(self.folder_hex)
        self._refresh_options_status()
        self.status_label.setText(f"Saved SVG: {dest}")

    def _on_apply_clicked(self) -> None:
        folders = self._collect_target_folders()
        if not folders:
            return
        if not self._ensure_preview_imported_if_needed():
            return

        ensure_dirs()
        sym_override = self._effective_symbol_color_arg()
        out_path = icon_path(
            symbol=self.selected_symbol,
            hex_color=self.folder_hex,
            symbol_color=sym_override,
            scale_ratio=self.scale_ratio,
            aliases=self.aliases,
        )
        svg_text = build_folder_svg(
            hex_color=self.folder_hex,
            symbol=self.selected_symbol,
            symbol_color=sym_override,
            all_symbols=self.all_symbols,
            scale_ratio=self.scale_ratio,
        )
        write_icon(svg_text, out_path)

        approve_all = False
        applied_count = 0
        is_batch = len(folders) > 1

        for folder_path in folders:
            existing_content = get_existing_directory_contents(folder_path)
            if existing_content is not None and not approve_all:
                dot_dir = folder_path / ".directory"
                buttons = QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No
                if is_batch:
                    buttons |= QMessageBox.StandardButton.YesToAll | QMessageBox.StandardButton.Cancel

                reply = QMessageBox.question(
                    self,
                    "Overwrite .directory Icon?",
                    f"'{dot_dir}' already exists and will be updated.\n\n"
                    f"Existing contents:\n{existing_content.strip()}\n\nProceed?",
                    buttons,
                    QMessageBox.StandardButton.No,
                )
                if reply == QMessageBox.StandardButton.Cancel:
                    break
                if reply == QMessageBox.StandardButton.YesToAll:
                    approve_all = True
                elif reply != QMessageBox.StandardButton.Yes:
                    continue

            try:
                apply_desktop_icon(folder_path, out_path.resolve())
                applied_count += 1
            except FolderIconError as exc:
                QMessageBox.critical(self, "Error", str(exc))
                return

        self._record_recent_color(self.folder_hex)
        self.state["last_folder"] = str(folders[-1])
        save_gui_state(self.state)
        self._refresh_target_status()

        fname = icon_filename(
            symbol=self.selected_symbol,
            hex_color=self.folder_hex,
            symbol_color=sym_override,
            scale_ratio=self.scale_ratio,
            aliases=self.aliases,
        )
        if applied_count == 0:
            self.status_label.setText("Apply cancelled; no folders modified.")
        elif is_batch:
            self.status_label.setText(f"Applied '{fname}' to {applied_count}/{len(folders)} folders.")
        else:
            self.status_label.setText(f"Applied '{fname}' -> {folders[0] / '.directory'}")

    def _on_revert_clicked(self) -> None:
        folders = self._collect_target_folders()
        if not folders:
            return

        styled = [
            f for f in folders
            if (info := inspect_directory_icon(f))["exists"] and info["icon"]
        ]
        if not styled:
            self.status_label.setText("Selected folder(s) already use the default Breeze icon.")
            self._refresh_target_status()
            return

        preview_lines = "\n".join(f"• {p}" for p in styled[:8])
        if len(styled) > 8:
            preview_lines += f"\n• ...and {len(styled) - 8} more"

        reply = QMessageBox.question(
            self,
            "Revert Folder Icon?",
            f"Remove custom .directory icon from {len(styled)} folder(s)?\n\n{preview_lines}",
            QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No,
            QMessageBox.StandardButton.No,
        )
        if reply != QMessageBox.StandardButton.Yes:
            self.status_label.setText("Revert cancelled.")
            return

        reverted = 0
        for folder_path in folders:
            try:
                res = reset_desktop_icon(folder_path)
                if res["status"] in ("deleted", "updated"):
                    reverted += 1
            except FolderIconError as exc:
                QMessageBox.critical(self, "Error", str(exc))
                return

        self._refresh_target_status()
        self.status_label.setText(f"Reverted {reverted} folder(s) to default Breeze icon.")

    # -----------------------------------------------------------------------
    # CUSTOM SVG IMPORT & DELETE
    # -----------------------------------------------------------------------

    def _on_import_svg_clicked(self) -> None:
        files, _ = QFileDialog.getOpenFileNames(
            self,
            "Import 24x24 Lucide SVG Symbol(s)",
            str(Path.home()),
            "SVG Files (*.svg)",
        )
        if not files:
            return
        for file_str in files:
            self._import_single_svg(Path(file_str), ask_name=(len(files) == 1))

    def _import_single_svg(self, source: Path, ask_name: bool = True) -> None:
        custom_name = source.stem.lower()
        if ask_name:
            entered, ok = QInputDialog.getText(
                self,
                "Symbol Name",
                f"Name for '{source.name}' (must be a 24x24 Lucide SVG):",
                text=custom_name,
            )
            if not ok or not entered.strip():
                return
            custom_name = entered.strip().lower()

        try:
            imported_name, dest = import_custom_svg(source, custom_name=custom_name, overwrite=False)
        except FolderIconError as exc:
            if "already exists" in str(exc):
                reply = QMessageBox.question(
                    self,
                    "Symbol Already Exists",
                    f"{exc}\n\nOverwrite existing custom symbol?",
                    QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No,
                    QMessageBox.StandardButton.No,
                )
                if reply != QMessageBox.StandardButton.Yes:
                    return
                try:
                    imported_name, dest = import_custom_svg(source, custom_name=custom_name, overwrite=True)
                except FolderIconError as inner_exc:
                    QMessageBox.critical(self, "Import Failed", str(inner_exc))
                    return
            else:
                QMessageBox.critical(self, "Invalid Lucide SVG", str(exc))
                return

        self.lucide_preview_name = None
        self.lucide_preview_inner = None
        self.selected_symbol = imported_name
        self.reload_catalog(preserve_selection=True)
        self.update_preview()
        self.status_label.setText(f"Imported custom symbol '{imported_name}' -> {dest}")

    def _on_delete_custom_clicked(self) -> None:
        if not self.selected_symbol or self.selected_symbol not in self.custom_symbols:
            return
        name = self.selected_symbol
        reply = QMessageBox.question(
            self,
            "Delete Custom Symbol",
            f"Delete custom symbol '{name}' from {SYMBOL_DIR}?",
            QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No,
            QMessageBox.StandardButton.No,
        )
        if reply != QMessageBox.StandardButton.Yes:
            return

        try:
            delete_custom_svg(name)
        except FolderIconError as exc:
            QMessageBox.critical(self, "Error", str(exc))
            return

        self.selected_symbol = "gamepad" if "gamepad" in LUCIDE_SYMBOLS else None
        self.reload_catalog(preserve_selection=True)
        if self.lucide_selected_name:
            self._update_lucide_footer(self.lucide_selected_name)
        self.update_preview()
        self.status_label.setText(f"Deleted custom symbol '{name}'.")

    # -----------------------------------------------------------------------
    # ALIAS MANAGEMENT
    # -----------------------------------------------------------------------

    def _on_create_alias_clicked(self) -> None:
        raw_target = self.alias_target_combo.currentText().strip()
        raw_alias = self.alias_name_input.text().strip()

        try:
            plan = check_alias_plan(raw_target, raw_alias)
        except FolderIconError as exc:
            QMessageBox.warning(self, "Invalid Alias", str(exc))
            return

        target_name = plan["target"]
        alias_name = plan["alias"]

        if plan["already_identical"]:
            self.status_label.setText(f"Alias '{alias_name}' already points to '{target_name}'.")
            return

        if plan["warnings"]:
            warning_bullets = "\n".join(f"• {w}" for w in plan["warnings"])
            reply = QMessageBox.warning(
                self,
                "Alias Conflict Warning",
                f"Creating alias '{alias_name}' -> '{target_name}' triggered warnings:\n\n"
                f"{warning_bullets}\n\nProceed anyway?",
                QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No,
                QMessageBox.StandardButton.No,
            )
            if reply != QMessageBox.StandardButton.Yes:
                self.status_label.setText("Alias creation cancelled.")
                return

        set_alias(target_name, alias_name)
        self.alias_name_input.clear()
        self.reload_catalog(preserve_selection=True)
        self.status_label.setText(f"Alias created: {alias_name} -> {target_name}")

    def _on_remove_alias_clicked(self) -> None:
        row = self.alias_table.currentRow()
        if row < 0:
            return
        alias_item = self.alias_table.item(row, 0)
        if alias_item is None:
            return
        alias_name = alias_item.text()
        try:
            remove_alias(alias_name)
        except FolderIconError as exc:
            QMessageBox.critical(self, "Error", str(exc))
            return

        self.reload_catalog(preserve_selection=True)
        self.status_label.setText(f"Removed alias '{alias_name}'.")

    def _on_alias_double_clicked(self, item: QTableWidgetItem) -> None:
        row = item.row()
        target_item = self.alias_table.item(row, 1)
        if target_item is None:
            return
        target = target_item.text()
        if target in self.all_symbols:
            self.lucide_preview_name = None
            self.lucide_preview_inner = None
            self.selected_symbol = target
            self.reload_catalog(preserve_selection=True)
            self.update_preview()
            self.tabs.setCurrentIndex(0)

    # -----------------------------------------------------------------------
    # DRAG AND DROP & WINDOW LIFECYCLE
    # -----------------------------------------------------------------------

    def dragEnterEvent(self, event: QDragEnterEvent) -> None:
        if event.mimeData().hasUrls():
            event.acceptProposedAction()

    def dropEvent(self, event: QDropEvent) -> None:
        urls = event.mimeData().urls()
        if not urls:
            return

        dropped_dirs: list[Path] = []
        dropped_svgs: list[Path] = []

        for url in urls:
            local = Path(url.toLocalFile())
            if local.is_dir():
                dropped_dirs.append(local)
            elif local.is_file() and local.suffix.lower() == ".svg":
                dropped_svgs.append(local)

        if dropped_dirs:
            if len(dropped_dirs) > 1 and not self.multi_mode:
                self.multi_toggle_btn.setChecked(True)
            if self.multi_mode:
                added = self._add_multi_folders(dropped_dirs)
                self.status_label.setText(f"Added {added} folder(s) to target queue.")
            else:
                self.folder_input.setText(str(dropped_dirs[0]))
                self.status_label.setText(f"Target folder set: {dropped_dirs[0]}")

        for svg_file in dropped_svgs:
            self._import_single_svg(svg_file, ask_name=(len(dropped_svgs) == 1))

    def closeEvent(self, event) -> None:
        for worker in list(self._active_workers):
            if worker.isRunning():
                worker.quit()
                worker.wait(500)
        super().closeEvent(event)


# ---------------------------------------------------------------------------
# ENTRY POINT
# ---------------------------------------------------------------------------

def main() -> None:
    app = QApplication(sys.argv)
    app.setApplicationName("folder-icon-gui")
    app.setStyleSheet(DARK_STYLESHEET)

    initial_folders: list[Path] = []
    for raw_arg in sys.argv[1:]:
        candidate = Path(raw_arg).expanduser().resolve()
        if candidate.is_dir() and candidate not in initial_folders:
            initial_folders.append(candidate)

    window = FolderIconWindow(initial_folders=initial_folders)
    window.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()