class LucideIndexWorker(QThread):
    """Fetch official Lucide icon names without blocking the UI thread."""

    finished_ok = Signal(list)
    failed = Signal(str)

    def __init__(self, force_refresh: bool = False, parent: QWidget | None = None) -> None:
        super().__init__(parent)
        self.force_refresh = force_refresh

    def run(self) -> None:
        try:
            names = fetch_lucide_icon_index(force_refresh=self.force_refresh)
            self.finished_ok.emit(names)
        except Exception as exc:
            self.failed.emit(str(exc))


class LucideSvgWorker(QThread):
    """Download and validate a single 24x24 Lucide SVG from GitHub."""

    finished_ok = Signal(str, str)
    failed = Signal(str, str)

    def __init__(self, icon_name: str, parent: QWidget | None = None) -> None:
        super().__init__(parent)
        self.icon_name = icon_name

    def run(self) -> None:
        try:
            svg_text = fetch_lucide_icon_svg(self.icon_name)
            self.finished_ok.emit(self.icon_name, svg_text)
        except Exception as exc:
            self.failed.emit(self.icon_name, str(exc))


class CacheScanWorker(QThread):
    """Scan folder registry and home directory for orphaned cache SVGs off the UI thread."""

    finished_ok = Signal(dict)
    failed = Signal(str)

    def __init__(self, parent: QWidget | None = None) -> None:
        super().__init__(parent)

    def run(self) -> None:
        try:
            report = scan_cache_usage()
            self.finished_ok.emit(report)
        except Exception as exc:
            self.failed.emit(str(exc))


