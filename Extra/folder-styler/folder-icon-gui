def render_svg_icon(svg_markup: str, size: int = 36) -> QIcon:
    """Render SVG text into a crisp QIcon for list items."""
    pixmap = QPixmap(size, size)
    pixmap.fill(Qt.GlobalColor.transparent)
    renderer = QSvgRenderer(QByteArray(svg_markup.encode("utf-8")))
    if renderer.isValid():
        painter = QPainter(pixmap)
        renderer.render(painter)
        painter.end()
    return QIcon(pixmap)


def render_svg_file_icon(svg_path: Path, size: int = 52) -> QIcon:
    """Render an on-disk SVG file into a crisp QIcon."""
    try:
        return render_svg_icon(svg_path.read_text(encoding="utf-8"), size=size)
    except Exception:
        return QIcon()


def format_bytes(num_bytes: int) -> str:
    if num_bytes < 1024:
        return f"{num_bytes} B"
    return f"{num_bytes / 1024.0:.1f} KB"


def summarize_folder_icon(dir_path: Path) -> str:
    """Return a concise one-line summary of dir_path/.directory icon status."""
    info = inspect_directory_icon(dir_path)
    if not info["exists"] or not info["icon"]:
        return "Default Breeze icon"

    meta = info["metadata"]
    if info["is_managed"] and meta:
        sym = meta.get("symbol", "none")
        col = meta.get("folder_color", "")
        parts = [sym]
        if col:
            parts.append(col)
        if not info["icon_exists"]:
            parts.append("missing SVG")
        return f"Styled: {', '.join(parts)}"

    icon_name = Path(info["icon"]).name
    missing = " [missing]" if (Path(info["icon"]).is_absolute() and not info["icon_exists"]) else ""
    return f"Custom: {icon_name}{missing}"


