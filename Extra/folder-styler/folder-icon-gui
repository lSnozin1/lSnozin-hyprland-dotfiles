    def _get_svg_save_dir(self) -> Path:
        raw = str(self.state.get("svg_save_dir", "")).strip()
        return Path(raw).expanduser() if raw else OUTPUT_DIR

    def _refresh_options_status(self) -> None:
        target_dir = self._get_svg_save_dir()
        if target_dir.exists() and not target_dir.is_dir():
            self.options_save_status.setText("Warning: Path points to a file, not a directory.")
            self.options_save_status.setStyleSheet("background-color: transparent; color: #fb7185; font-size: 12px;")
        elif target_dir.is_dir():
            self.options_save_status.setText(f"Active save folder: {target_dir}")
            self.options_save_status.setStyleSheet("background-color: transparent; color: #c084fc; font-size: 12px;")
        else:
            self.options_save_status.setText(f"Folder will be created automatically on save: {target_dir}")
            self.options_save_status.setStyleSheet("background-color: transparent; color: #9ca3af; font-size: 12px;")

    def _update_save_svg_tooltip(self) -> None:
        self.save_svg_btn.setToolTip(f"Save SVG directly to {self._get_svg_save_dir()}")

    def _on_options_save_dir_changed(self, text: str) -> None:
        cleaned = text.strip()
        self.state["svg_save_dir"] = cleaned if cleaned else str(OUTPUT_DIR)
        save_gui_state(self.state)
        self._refresh_options_status()
        self._update_save_svg_tooltip()

    def _on_browse_svg_save_dir(self) -> None:
        current = self._get_svg_save_dir()
        start = str(current if current.is_dir() else Path.home())
        chosen = QFileDialog.getExistingDirectory(self, "Choose SVG Save Folder", start)
        if chosen:
            self.options_save_dir_input.setText(chosen)

    def _on_reset_svg_save_dir(self) -> None:
        self.options_save_dir_input.setText(str(OUTPUT_DIR))
        self.status_label.setText(f"SVG save path reset to {OUTPUT_DIR}")

    # -----------------------------------------------------------------------
    # CATALOG & ALIAS REFRESH
    # -----------------------------------------------------------------------

    def reload_catalog(self, preserve_selection: bool = True) -> None:
        current = self.selected_symbol if preserve_selection else None
        self.all_symbols, self.aliases = get_all_symbols()
        custom_loaded = load_custom_symbols()
        assert isinstance(custom_loaded, dict)
        self.custom_symbols = custom_loaded

        base_names = sorted(set(LUCIDE_SYMBOLS.keys()) | set(self.custom_symbols.keys()))
        prev_target = self.alias_target_combo.currentText()
        self.alias_target_combo.clear()
        self.alias_target_combo.addItems(base_names)
        if prev_target in base_names:
            self.alias_target_combo.setCurrentText(prev_target)
        elif self.selected_symbol in base_names:
            self.alias_target_combo.setCurrentText(self.selected_symbol)

        self._populate_symbol_grid(restore_symbol=current)
        self._populate_alias_table()
        if self.lucide_index_loaded:
            self._populate_lucide_list()

    def _populate_symbol_grid(self, _text: str = "", restore_symbol: str | None = None) -> None:
        target_restore = restore_symbol if restore_symbol is not None else self.selected_symbol
        query = self.search_input.text().strip().lower()
        mode = self.filter_combo.currentIndex()  # 0 = All, 1 = Built-in, 2 = Custom

        reverse_aliases: dict[str, list[str]] = {}
        for alias_name, target in sorted(self.aliases.items()):
            reverse_aliases.setdefault(target, []).append(alias_name)

        self.symbol_list.blockSignals(True)
        self.symbol_list.clear()

        if mode == 0 and (not query or query in "none plain empty"):
            none_svg = (
                '<?xml version="1.0" encoding="UTF-8"?>'
                '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">'
                '<circle cx="12" cy="12" r="8" fill="none" stroke="#9ca3af" '
                'stroke-width="1.8" stroke-dasharray="3 3"/>'
                '</svg>'
            )
            none_item = QListWidgetItem(render_svg_icon(none_svg), "none")
            none_item.setData(Qt.ItemDataRole.UserRole, None)
            none_item.setToolTip("Plain colored folder (no symbol)")
            self.symbol_list.addItem(none_item)
            if target_restore is None:
                self.symbol_list.setCurrentItem(none_item)

        base_names = sorted(set(LUCIDE_SYMBOLS.keys()) | set(self.custom_symbols.keys()))
        for name in base_names:
            is_custom = name in self.custom_symbols
            if mode == 1 and is_custom:
                continue
            if mode == 2 and not is_custom:
                continue

            linked_aliases = reverse_aliases.get(name, [])
            searchable = " ".join([name] + linked_aliases)
            if query and query not in searchable:
                continue

            stroke = "#f0abfc" if is_custom else "#f4f4f6"
            preview_svg = build_symbol_preview_svg(name, self.all_symbols, stroke_color=stroke)
            label = f"{name} *" if is_custom else name
            item = QListWidgetItem(render_svg_icon(preview_svg), label)
            item.setData(Qt.ItemDataRole.UserRole, name)

            tip_parts = [f"Symbol: {name}"]
            if is_custom:
                tip_parts.append("Source: Custom SVG")
            if linked_aliases:
                tip_parts.append(f"Aliases: {', '.join(linked_aliases)}")
            item.setToolTip("\n".join(tip_parts))

            self.symbol_list.addItem(item)
            if target_restore == name:
                self.symbol_list.setCurrentItem(item)

        self.symbol_list.blockSignals(False)
        self._sync_custom_delete_state()

    def _populate_alias_table(self) -> None:
        base_names = set(LUCIDE_SYMBOLS.keys()) | set(self.custom_symbols.keys())
        sorted_aliases = sorted(self.aliases.items())
        self.alias_table.setRowCount(len(sorted_aliases))

        for row, (alias_name, target) in enumerate(sorted_aliases):
            alias_item = QTableWidgetItem(alias_name)
            target_item = QTableWidgetItem(target)
            status_text = "Valid" if target in base_names else "Missing target"
            status_item = QTableWidgetItem(status_text)
            if target not in base_names:
                status_item.setForeground(QColor("#fb7185"))
            else:
                status_item.setForeground(QColor("#c084fc"))

            self.alias_table.setItem(row, 0, alias_item)
            self.alias_table.setItem(row, 1, target_item)
            self.alias_table.setItem(row, 2, status_item)

    # -----------------------------------------------------------------------
    # TAB SWITCHING & WORKER TRACKING
    # -----------------------------------------------------------------------

    def _track_worker(self, worker: QThread) -> None:
        self._active_workers.add(worker)
        worker.finished.connect(lambda w=worker: self._cleanup_worker(w))

    def _cleanup_worker(self, worker: QThread) -> None:
        self._active_workers.discard(worker)
        worker.deleteLater()

    def _on_tab_changed(self, index: int) -> None:
        if index == self.lucide_tab_index and not self.lucide_index_loaded:
            self._load_lucide_index(force_refresh=False)
        elif index == self.gc_tab_index and not self._cache_scanning:
            self._start_cache_scan()

    # -----------------------------------------------------------------------
    # LIVE LUCIDE BROWSER TAB
    # -----------------------------------------------------------------------

    def _load_lucide_index(self, force_refresh: bool = False) -> None:
        self.lucide_refresh_btn.setEnabled(False)
        self.lucide_count_label.setText(
            "Refreshing Lucide icon index from GitHub..."
            if force_refresh
            else "Loading official Lucide icon index..."
        )
        worker = LucideIndexWorker(force_refresh=force_refresh, parent=self)
        self._track_worker(worker)
        worker.finished_ok.connect(self._on_lucide_index_loaded)
        worker.failed.connect(self._on_lucide_index_failed)
        worker.start()

    def _on_lucide_index_loaded(self, names: list[str]) -> None:
        self.lucide_index = names
        self.lucide_index_loaded = True
        self.lucide_refresh_btn.setEnabled(True)
        self._populate_lucide_list()
        if self.lucide_selected_name:
            self._update_lucide_footer(self.lucide_selected_name)

    def _on_lucide_index_failed(self, error_msg: str) -> None:
        self.lucide_refresh_btn.setEnabled(True)
        self.lucide_count_label.setText(f"Failed to load Lucide index: {error_msg}")
        self.status_label.setText(f"Lucide fetch error: {error_msg}")

    def _lucide_item_icon(self, name: str) -> QIcon:
        if name in self.custom_symbols:
            svg = build_symbol_preview_svg(name, self.all_symbols, stroke_color="#f0abfc")
            return render_svg_icon(svg, size=22)
        if name in LUCIDE_SYMBOLS:
            svg = build_symbol_preview_svg(name, self.all_symbols, stroke_color="#e4e4e7")
            return render_svg_icon(svg, size=22)
        if name in self.lucide_svg_cache:
            try:
                inner = validate_and_extract_svg(self.lucide_svg_cache[name])
                svg = build_symbol_preview_svg(name, {name: inner}, stroke_color="#d8b4fe")
                return render_svg_icon(svg, size=22)
            except Exception:
                pass
        return self._placeholder_icon

    def _lucide_item_label(self, name: str) -> str:
        if name in self.custom_symbols:
            return f"{name}    [custom]"
        if name in LUCIDE_SYMBOLS:
            return f"{name}    [built-in]"
        return name

    def _populate_lucide_list(self, _text: str = "") -> None:
        if not self.lucide_index_loaded:
            return

        query = self.lucide_search_input.text().strip().lower()
        mode = self.lucide_filter_combo.currentIndex()  # 0 = All, 1 = Not Installed, 2 = Already Installed
        installed = set(LUCIDE_SYMBOLS.keys()) | set(self.custom_symbols.keys())

        matches: list[str] = []
        for name in self.lucide_index:
            is_installed = name in installed
            if mode == 1 and is_installed:
                continue
            if mode == 2 and not is_installed:
                continue
            if query and query not in name:
                continue
            matches.append(name)

        self.lucide_result_list.blockSignals(True)
        self.lucide_result_list.clear()

        for name in matches:
            item = QListWidgetItem(self._lucide_item_icon(name), self._lucide_item_label(name))
            item.setData(Qt.ItemDataRole.UserRole, name)
            self.lucide_result_list.addItem(item)
            if name == self.lucide_selected_name:
                self.lucide_result_list.setCurrentItem(item)

        self.lucide_result_list.blockSignals(False)
        self.lucide_count_label.setText(
            f"Showing {len(matches)} of {len(self.lucide_index)} official Lucide icons  •  Click to preview live"
        )

    def _on_lucide_item_selected(
        self,
        current: QListWidgetItem | None,
        _prev: QListWidgetItem | None,
    ) -> None:
        if current is None:
            return
        icon_name = current.data(Qt.ItemDataRole.UserRole)
        if not isinstance(icon_name, str):
            return

        self.lucide_selected_name = icon_name
        self._update_lucide_footer(icon_name)

        if icon_name in self.lucide_svg_cache:
            self._apply_lucide_preview_from_raw(icon_name, self.lucide_svg_cache[icon_name])
            return

        if icon_name in self.all_symbols:
            self.lucide_preview_name = icon_name
            self.lucide_preview_inner = self.all_symbols[icon_name]
            glyph_svg = build_symbol_preview_svg(icon_name, self.all_symbols, stroke_color="#f0abfc")
            self.lucide_glyph_preview.load(QByteArray(glyph_svg.encode("utf-8")))
            self.update_preview()
            return

        self.lucide_import_btn.setEnabled(False)
        self.lucide_import_as_btn.setEnabled(False)
        self.lucide_detail_label.setText(f"Downloading '{icon_name}.svg' from lucide.dev...")
        self.status_label.setText(f"Fetching Lucide icon '{icon_name}'...")

        worker = LucideSvgWorker(icon_name, parent=self)
        self._track_worker(worker)
        worker.finished_ok.connect(self._on_lucide_svg_fetched)
        worker.failed.connect(self._on_lucide_svg_failed)
        worker.start()

    def _on_lucide_svg_fetched(self, icon_name: str, raw_svg: str) -> None:
        self.lucide_svg_cache[icon_name] = raw_svg

        for idx in range(self.lucide_result_list.count()):
            item = self.lucide_result_list.item(idx)
            if item.data(Qt.ItemDataRole.UserRole) == icon_name:
                item.setIcon(self._lucide_item_icon(icon_name))
                break

        if self.lucide_selected_name != icon_name:
            return

        self._apply_lucide_preview_from_raw(icon_name, raw_svg)
        self._update_lucide_footer(icon_name)
        self.status_label.setText(f"Previewing Lucide icon '{icon_name}' (not yet imported).")

    def _on_lucide_svg_failed(self, icon_name: str, error_msg: str) -> None:
        if self.lucide_selected_name == icon_name:
            self.lucide_detail_label.setText(error_msg)
        self.status_label.setText(error_msg)

    def _apply_lucide_preview_from_raw(self, icon_name: str, raw_svg: str) -> None:
        try:
            inner = validate_and_extract_svg(raw_svg)
        except FolderIconError as exc:
            self.lucide_detail_label.setText(str(exc))
            return

        self.lucide_preview_name = icon_name
        self.lucide_preview_inner = inner

        glyph_svg = build_symbol_preview_svg(icon_name, {icon_name: inner}, stroke_color="#f0abfc")
        self.lucide_glyph_preview.load(QByteArray(glyph_svg.encode("utf-8")))
        self.update_preview()

    def _update_lucide_footer(self, icon_name: str) -> None:
        is_custom = icon_name in self.custom_symbols
        is_builtin = icon_name in LUCIDE_SYMBOLS
        has_svg = icon_name in self.lucide_svg_cache or is_custom or is_builtin

        self.lucide_selected_label.setText(f"lucide / {icon_name}")
        if is_custom:
            self.lucide_detail_label.setText(f"Already imported in {SYMBOL_DIR}/{icon_name}.svg")
            self.lucide_import_btn.setText("Re-import")
        elif is_builtin:
            self.lucide_detail_label.setText("Included in built-in symbols (import to create a custom override)")
            self.lucide_import_btn.setText("Import Override")
        else:
            self.lucide_detail_label.setText("Online preview — click Import Symbol to save offline")
            self.lucide_import_btn.setText("Import Symbol")

        self.lucide_import_btn.setEnabled(has_svg)
        self.lucide_import_as_btn.setEnabled(has_svg)

    def _on_import_lucide_clicked(self, ask_name: bool = False) -> None:
        icon_name = self.lucide_selected_name
        if not icon_name:
            return

        raw_svg = self.lucide_svg_cache.get(icon_name)
        if not raw_svg:
            try:
                raw_svg = fetch_lucide_icon_svg(icon_name)
                self.lucide_svg_cache[icon_name] = raw_svg
            except FolderIconError as exc:
                QMessageBox.critical(self, "Download Failed", str(exc))
                return

        target_name = icon_name
        if ask_name:
            entered, ok = QInputDialog.getText(
                self,
                "Import Lucide Symbol As",
                f"Save '{icon_name}' into custom symbols as:",
                text=icon_name,
            )
            if not ok or not entered.strip():
                return
            target_name = entered.strip().lower()

        try:
            imported_name, dest = save_custom_svg_content(raw_svg, target_name, overwrite=False)
        except FolderIconError as exc:
            if "already exists" in str(exc):
                reply = QMessageBox.question(
                    self,
                    "Symbol Already Exists",
                    f"{exc}\n\nOverwrite existing custom symbol?",
                    QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No,
                    QMessageBox.StandardButton.No,
                )
                if reply != QMessageBox.StandardButton.Yes:
                    return
                try:
                    imported_name, dest = save_custom_svg_content(raw_svg, target_name, overwrite=True)
                except FolderIconError as inner_exc:
                    QMessageBox.critical(self, "Import Failed", str(inner_exc))
                    return
            else:
                QMessageBox.critical(self, "Invalid Lucide SVG", str(exc))
                return

        self.selected_symbol = imported_name
        self.lucide_preview_name = None
        self.lucide_preview_inner = None
        self.reload_catalog(preserve_selection=True)
        self._update_lucide_footer(icon_name)
        self.update_preview()
        self.status_label.setText(f"Imported Lucide symbol '{imported_name}' -> {dest}")

    def _ensure_preview_imported_if_needed(self) -> bool:
        """
        If the folder preview is currently showing an un-imported online Lucide icon,
        offer to import it into SYMBOL_DIR before applying or saving.
        """
        if not self.lucide_preview_name:
            return True

        name = self.lucide_preview_name
        if name in self.all_symbols:
            self.selected_symbol = name
            self.lucide_preview_name = None
            self.lucide_preview_inner = None
            self.reload_catalog(preserve_selection=True)
            return True

        reply = QMessageBox.question(
            self,
            "Import Previewed Lucide Icon?",
            f"'{name}' is currently an online preview from Lucide and has not been saved locally yet.\n\n"
            f"Import '{name}.svg' into {SYMBOL_DIR} and continue?",
            QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No,
            QMessageBox.StandardButton.Yes,
        )
        if reply != QMessageBox.StandardButton.Yes:
            return False

        raw_svg = self.lucide_svg_cache.get(name)
        if not raw_svg:
            try:
                raw_svg = fetch_lucide_icon_svg(name)
                self.lucide_svg_cache[name] = raw_svg
            except FolderIconError as exc:
                QMessageBox.critical(self, "Import Failed", str(exc))
                return False

        try:
            imported_name, _dest = save_custom_svg_content(raw_svg, name, overwrite=True)
        except FolderIconError as exc:
            QMessageBox.critical(self, "Import Failed", str(exc))
            return False

        self.selected_symbol = imported_name
        self.lucide_preview_name = None
        self.lucide_preview_inner = None
        self.reload_catalog(preserve_selection=True)
        if self.lucide_selected_name:
            self._update_lucide_footer(self.lucide_selected_name)
        return True

    # -----------------------------------------------------------------------
    # CACHE CLEANUP TAB (Background Scan + Interactive Selection)
    # -----------------------------------------------------------------------

    def _start_cache_scan(self) -> None:
        if self._cache_scanning:
            return
        self._cache_scanning = True
        self.gc_rescan_btn.setEnabled(False)
        self.gc_select_all_btn.setEnabled(False)
        self.gc_unselect_all_btn.setEnabled(False)
        self.gc_delete_btn.setEnabled(False)
        self.gc_summary_label.setText("Scanning...")
        self.gc_loading_label.setText("Scanning tracked folders and home directories for orphaned SVGs...")
        self.gc_loading_bar.setVisible(True)

        worker = CacheScanWorker(parent=self)
        self._track_worker(worker)
        worker.finished_ok.connect(self._on_cache_scan_finished)
        worker.failed.connect(self._on_cache_scan_failed)
        worker.start()

    def _on_cache_scan_finished(self, report: dict) -> None:
        self._cache_scanning = False
        self.gc_loading_bar.setVisible(False)
        self.gc_rescan_btn.setEnabled(True)

        in_use = report["in_use"]
        orphaned = report["orphaned"]
        total = report["total_count"]
        reclaimable = format_bytes(report["orphaned_bytes"])

        self.gc_summary_label.setText(
            f"{total} cached  •  {len(in_use)} in use  •  {len(orphaned)} orphaned ({reclaimable})"
        )

        self.orphan_list.blockSignals(True)
        self.orphan_list.clear()

        for record in orphaned:
            svg_path: Path = record["path"]
            meta: dict[str, str] = record["metadata"]
            size_str = format_bytes(record["size"])
            label = f"{svg_path.stem}\n({size_str})"

            item = QListWidgetItem(render_svg_file_icon(svg_path, size=52), label)
            item.setFlags(item.flags() | Qt.ItemFlag.ItemIsUserCheckable)
            item.setCheckState(Qt.CheckState.Checked)
            item.setData(Qt.ItemDataRole.UserRole, svg_path)

            tip_lines = [f"File: {svg_path.name}", f"Size: {size_str}"]
            if meta.get("symbol"):
                tip_lines.append(f"Symbol: {meta['symbol']}")
            if meta.get("folder_color"):
                tip_lines.append(f"Color: {meta['folder_color']}")
            if meta.get("symbol_scale"):
                tip_lines.append(f"Scale: {meta['symbol_scale']}")
            item.setToolTip("\n".join(tip_lines))
            self.orphan_list.addItem(item)

        self.orphan_list.blockSignals(False)
        has_orphans = len(orphaned) > 0
        self.gc_select_all_btn.setEnabled(has_orphans)
        self.gc_unselect_all_btn.setEnabled(has_orphans)
        self._update_gc_selected_count()

    def _on_cache_scan_failed(self, error_msg: str) -> None:
        self._cache_scanning = False
        self.gc_loading_bar.setVisible(False)
        self.gc_rescan_btn.setEnabled(True)
        self.gc_summary_label.setText(f"Scan failed: {error_msg}")
        self.status_label.setText(f"Cache scan failed: {error_msg}")

    def _toggle_gc_item_check(self, item: QListWidgetItem) -> None:
        next_state = (
            Qt.CheckState.Unchecked
            if item.checkState() == Qt.CheckState.Checked
            else Qt.CheckState.Checked
        )
        item.setCheckState(next_state)

    def _set_all_gc_checked(self, checked: bool) -> None:
        state = Qt.CheckState.Checked if checked else Qt.CheckState.Unchecked
        self.orphan_list.blockSignals(True)
        for idx in range(self.orphan_list.count()):
            self.orphan_list.item(idx).setCheckState(state)
        self.orphan_list.blockSignals(False)
        self._update_gc_selected_count()

    def _checked_orphan_paths(self) -> list[Path]:
        selected: list[Path] = []
        for idx in range(self.orphan_list.count()):
            item = self.orphan_list.item(idx)
            if item.checkState() == Qt.CheckState.Checked:
                path_val = item.data(Qt.ItemDataRole.UserRole)
                if isinstance(path_val, Path):
                    selected.append(path_val)
        return selected

    def _update_gc_selected_count(self) -> None:
        count = len(self._checked_orphan_paths())
        self.gc_delete_btn.setText(f"Delete Selected ({count})")
        self.gc_delete_btn.setEnabled(count > 0 and not self._cache_scanning)

    def _on_delete_selected_orphans(self) -> None:
        targets = self._checked_orphan_paths()
        if not targets:
            return
        reply = QMessageBox.question(
            self,
            "Delete Orphaned Icons?",
            f"Permanently delete {len(targets)} unreferenced SVG file(s) from {OUTPUT_DIR}?",
            QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No,
            QMessageBox.StandardButton.No,
        )
        if reply != QMessageBox.StandardButton.Yes:
            return

        deleted = delete_cached_icons(targets)
        self.status_label.setText(f"Cache cleanup: removed {len(deleted)} orphaned SVG(s).")
        self._start_cache_scan()

